# ── PostgreSQL credentials ─────────────────────────────────────
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=muleshield

# ── Backend ────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://your_db_user:your_secure_password@db:5432/muleshield
DEBUG=false
